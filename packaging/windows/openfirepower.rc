// The game's icon and version, for Windows
#include <winver.h>
1 ICON "openfirepower.ico"
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "The OpenFP project"
      VALUE "FileDescription",  "OpenFP tank combat"
      VALUE "FileVersion",      "0.1"
      VALUE "InternalName",     "openfirepower"
      VALUE "LegalCopyright",   "MIT licence"
      VALUE "OriginalFilename", "openfirepower.exe"
      VALUE "ProductName",      "OpenFP"
      VALUE "ProductVersion",   "0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
